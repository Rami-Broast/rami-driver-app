# Build-time configuration for the driver app.
#
# VARIABLE NAMES ONLY — never commit a real value. Copy to `.env` (git-ignored)
# for local development, or set them as EAS secrets for a real build.
# `app.config.js` reads these and injects them into the Expo config.

# Google Maps key used for navigation and the delivery map.
# Restrict it to the Android/iOS bundle identifiers in the Google console.
GOOGLE_MAPS_API_KEY=

# API base URL, including the /api/v1 prefix. Defaults to the value in app.json.
API_BASE_URL=
